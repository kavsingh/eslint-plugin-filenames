{
	"extends": [
		"@tsconfig/strictest/tsconfig.json",
		"@tsconfig/node24/tsconfig.json"
	],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"rootDir": ".",
		"declaration": true,
		"erasableSyntaxOnly": true,
		"noEmitHelpers": true,
		"importHelpers": true,
		"pretty": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true
	},
	"include": ["./*.ts", "./*.js", "src", "test"]
}
